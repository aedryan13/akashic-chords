{
  "project": "aedryan-gantt-music-group/akashic-chords-source",
  "allowed_targets": ["claude/tips-tidy", "claude/rewrite"],
  "target_rules": [
    {"prefix": "claude/rewrite-", "target": "claude/rewrite"}
  ],
  "default_target": "claude/tips-tidy",
  "never_touch_branches": ["claude/tips-tidy", "claude/rewrite", "claude/black-ink-sync", "main"],
  "skip_suffixes": ["-wip", "-hold"],
  "hold_labels": ["hold", "do not merge"],
  "conflict_label": "auto-merge: needs fix",
  "only_branches_pushed_after": "2026-11-15T21:30:00Z",
  "settle_minutes": 10,
  "max_actions_per_run": 5
}
