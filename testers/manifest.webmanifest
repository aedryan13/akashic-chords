{
  "name": "Akashic Chords (testers)",
  "short_name": "Akashic Testers",
  "description": "Testers copy of Akashic Chords.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#07060F",
  "theme_color": "#2A1650",
  "categories": [
    "music"
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "audio",
          "accept": [
            "audio/*",
            ".m4a",
            ".mp3",
            ".wav",
            ".aac",
            ".ogg",
            ".webm",
            ".3gp",
            ".amr"
          ]
        }
      ]
    }
  },
  "shortcuts": [
    {
      "name": "Write now",
      "short_name": "Write now",
      "description": "A new song, ready to record",
      "url": "./?write=now",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
